set -euo pipefail

ROOT="$(dirname "${0}")"

source "${ROOT}"/globals

IOSEVKA_CURRENT="$(sed -n 's/^IOSEVKA=\(.*\)/\1/p' "${ROOT}"/build)"
NERDFONT_CURRENT="$(sed -n 's/^NERDFONT=\(.*\)/\1/p' "${ROOT}"/build)"

IOSEVKA_LATEST="$(git ls-remote --sort='version:refname' --tags https://github.com/be5invis/Iosevka.git 2> /dev/null | tail -n1 | cut -d/ -f3)"
NERDFONT_LATEST="$(git ls-remote --sort='version:refname' --tags https://github.com/ryanoasis/nerd-fonts.git 2> /dev/null | tail -n1 | cut -d/ -f3)"

show_header "Jambo Mono — version check"
echo "  Iosevka:    ${IOSEVKA_CURRENT}  (latest: ${IOSEVKA_LATEST:-unknown})"
echo "  Nerd Fonts: ${NERDFONT_CURRENT}  (latest: ${NERDFONT_LATEST:-unknown})"
echo ""

if [ "${IOSEVKA_CURRENT}" = "${IOSEVKA_LATEST}" ] && [ "${NERDFONT_CURRENT}" = "${NERDFONT_LATEST}" ]; then
  show_success "No updates available."
else
  show_warning "Updates available!"
  echo ""
  echo "Font builds are now handled by GitHub Actions."
  echo "Run the workflow manually at:"
  echo "  https://github.com/sudorook/fonts-jambo/actions/workflows/ci.yml"
  echo ""
  echo "A weekly scheduled run also checks for and builds updates automatically."
fi
